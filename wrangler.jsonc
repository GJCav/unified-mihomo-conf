{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unified-mihomo-conf",
  "main": "./server/index.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mihomo-conf.crychic.uk",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["BASIC_AUTH_CREDENTIALS"]
  },
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "731904621",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
